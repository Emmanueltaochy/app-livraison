# En local : copier en .env.local. Sur le VPS : copier en /opt/fretpei/.env.

# --- Base de données ---
# Sur le VPS (docker compose) : seul le mot de passe est à définir, l'URL est construite automatiquement.
POSTGRES_PASSWORD=
# En local uniquement :
DATABASE_URL=postgresql://postgres@localhost:5432/fretpei

# --- Site ---
# Nom de domaine pointant vers l'IP du VPS (enregistrement DNS A), sans https://
# Provisoire, en attendant le nom de domaine définitif
DOMAINE=livraison.taochyconsulting.fr
# Port local de l'app sur le VPS (à changer s'il est déjà pris par une autre app)
APP_PORT=3100
SITE_URL=https://livraison.taochyconsulting.fr

# --- E-mails (liens de connexion) : messagerie Hostinger ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@fretpei.re
SMTP_PASSWORD=
SMTP_FROM=FretPéi <contact@fretpei.re>

# --- Stripe (https://dashboard.stripe.com) → Développeurs > Clés API. Activer Connect. ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Clé publique (pk_…) : paiement affiché dans la plateforme au lieu de la page Stripe
STRIPE_PUBLISHABLE_KEY=
# Destinataire du formulaire de contact (par défaut SMTP_USER)
CONTACT_EMAIL=

# Paiement simulé en local, sans Stripe (ignoré en production)
PAIEMENT_DEMO=1
